rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
    }

    match /race_results/{calendarId} {
      allow read;
      allow write: if request.auth != null;
    }

    match /grids/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /banner_calendar/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /driver_profiles/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /seasons/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /calendar-seasons/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /point_adjustments/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }
    match /driver_stats_offsets/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /driver_cards/{document=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}